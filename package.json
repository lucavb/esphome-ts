{
    "name": "esphome-ts",
    "version": "5.0.0",
    "description": "A TypeScript client for the Esphome Native API interface",
    "type": "module",
    "sideEffects": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lucavb/esphome-ts.git"
    },
    "files": [
        "dist/*"
    ],
    "scripts": {
        "build": "tsup",
        "cbuild": "npm run clean && npm run build",
        "clean": "rm -rf dist",
        "proto": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/api/protobuf --ts_proto_opt=esModuleInterop=true,env=node,outputServices=false -I src/api/protobuf src/api/protobuf/api.proto src/api/protobuf/api_options.proto src/api/protobuf/google_descriptor.proto",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . && prettier \"**/*\" --check --ignore-unknown",
        "lint:commitlint": "commitlint -f origin/main",
        "lint:fix": "eslint . --fix",
        "format": "prettier \"**/*\" --write --ignore-unknown",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepack": "npm run cbuild",
        "semantic-release": "semantic-release"
    },
    "keywords": [
        "esphome",
        "typescript"
    ],
    "author": "Luca Becker <luca.becker@sunbury.xyz> (https://sunbury.xyz/)",
    "license": "GPL-3.0",
    "dependencies": {
        "@bufbuild/protobuf": "2.16.0",
        "color-convert": "3.1.3"
    },
    "peerDependencies": {
        "rxjs": "^7.8.0"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.3",
        "@commitlint/config-conventional": "21.2.3",
        "@eslint/js": "10.0.1",
        "@semantic-release/changelog": "7.0.0",
        "@semantic-release/git": "11.0.1",
        "@types/node": "26.6.3",
        "@vitest/coverage-v8": "5.0.3",
        "eslint": "10.11.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-unused-imports": "4.4.1",
        "prettier": "3.9.9",
        "rxjs": "7.8.2",
        "semantic-release": "25.0.9",
        "ts-proto": "2.12.4",
        "tsup": "8.5.1",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "vitest": "5.0.3"
    },
    "allowScripts": {
        "unrs-resolver@1.12.2": true,
        "esbuild@0.28.2": true,
        "esbuild@0.27.7": true
    }
}
